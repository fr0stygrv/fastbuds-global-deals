{
  "redirects": [
    { "source": "/", "destination": "/en", "permanent": true },
    { "source": "/:lang/", "destination": "/:lang", "permanent": true },
    { "source": "/pt/cupom/oferta-buzz-15-melhores-escolhas", "destination": "/pt/cupom/crie-buzz-15-sementes-tendencia", "permanent": true },
    { "source": "/pt/cupom/buzz-em-alta-15-desconto-melhores-escolhas", "destination": "/pt/cupom/crie-buzz-15-sementes-tendencia", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/:lang(en|de|es|pt|fr|it)/:type(coupon|cupon|cupom)/:slug",
      "destination": "/api/og?slug=:lang/:type/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|TwitterBot|LinkedInBot|WhatsApp|WhatsAppBot|Telegram|TelegramBot|Slackbot|Pinterest|SkypeUriPreview|vkShare|redditbot|Discordbot).*"
        }
      ]
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
